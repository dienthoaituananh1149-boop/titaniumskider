chrome_public_manifest_package = "io.github.jqssun.helium"
is_desktop_android = true
target_os = "android"
target_cpu = "arm64"
enable_android_secondary_abi = false

# Optimization & Compiler Flags
is_official_build = true
is_component_build = false
is_debug = false
symbol_level = 0
thin_lto_enable_optimizations = true

# Linker & Toolchain
use_siso = true
generate_linker_map = false
exclude_unwind_tables = true
use_rtti = false
dcheck_always_on = false
enable_iterator_debugging = false
use_errorprone_java_compiler = false

# Allocator & Memory Tuning
use_partition_alloc = true
use_partition_alloc_as_malloc = true
enable_gwp_asan = false
enable_backup_ref_ptr_support = false

# V8 JavaScript / WebAssembly Tuning
v8_enable_drumbrake = false
v8_drumbrake_bounds_checks = false
v8_enable_maglev = true
v8_enable_turbofan = true
include_both_v8_snapshots = false
include_both_v8_snapshots_android_secondary_abi = false

# Graphics & Media Accelerators
enable_vulkan = true
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_av1_decoder = true
enable_dav1d_decoder = true

# Bloat Stripping (VR/AR/Enterprise/Telemetry)
enable_vr = false
enable_arcore = false
enable_openxr = false
enable_cardboard = false
enable_remoting = false
enable_reporting = false
build_contextual_search = false

# Runtime & Compatibility Backends
use_login_database_as_backend = true
disable_fieldtrial_testing_config = true
icu_use_data_file = true
rtc_build_examples = false
google_api_key = "x"
google_default_client_id = "x"
google_default_client_secret = "x"